generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  ORGANIZER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    Event[]
}

model Venue {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  address     String
  city        String
  state       String
  country     String
  postalCode  String
  capacity    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events      Event[]
  seats       Seat[]
}

enum SeatType {
  REGULAR
  PREMIUM
  VIP
}

model Seat {
  id        String   @id @default(uuid())

  venueId   String
  row       String
  number    Int
  section   String?
  type      SeatType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue     Venue       @relation(fields: [venueId], references: [id])
  eventSeats EventSeat[]

  @@unique([venueId, row, number])
  @@index([venueId])
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String?

  category    EventCategory
  status      EventStatus

  startTime   DateTime
  endTime     DateTime

  venueId     String
  organizerId String

  imageUrl    String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  venue       Venue         @relation(fields: [venueId], references: [id])
  organizer   User          @relation(fields: [organizerId], references: [id])
  eventSeats  EventSeat[]

  @@index([organizerId])
  @@index([venueId])
  @@index([startTime])
  @@index([status])
}

model EventSeat {
  id        String         @id @default(uuid())

  eventId   String
  seatId    String

  status    EventSeatStatus

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  event     Event          @relation(fields: [eventId], references: [id])
  seat      Seat           @relation(fields: [seatId], references: [id])

  @@unique([eventId, seatId])
  @@index([eventId])
  @@index([seatId])
  @@index([status])
}

enum EventSeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
}

enum EventCategory {
  CONCERT
  SPORTS
  CONFERENCE
  COMEDY
  THEATRE
  WORKSHOP
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}