generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  ORGANIZER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    Event[]
  reservations Reservation[]
  bookings     Booking[]
  payments     Payment[]

}

model Venue {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  address     String
  city        String
  state       String
  country     String
  postalCode  String
  capacity    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events      Event[]
  seats       Seat[]
}

enum SeatType {
  REGULAR
  PREMIUM
  VIP
}

model Seat {
  id        String   @id @default(uuid())

  venueId   String
  row       String
  number    Int
  section   String?
  type      SeatType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue      Venue       @relation(fields: [venueId], references: [id])
  eventSeats EventSeat[]

  @@unique([venueId, row, number])
  @@index([venueId])
}

enum EventType {
  SEATED
  GENERAL_ADMISSION
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String?

  category    EventCategory
  type        EventType    @default(SEATED)
  status      EventStatus

  startTime   String
  endTime     String

  venueId     String
  organizerId String

  imageUrl    String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  venue       Venue         @relation(fields: [venueId], references: [id])
  organizer   User          @relation(fields: [organizerId], references: [id])

  eventSeats  EventSeat[]
  ticketTypes TicketType[]
  reservations Reservation[]
  bookings     Booking[]

  @@index([organizerId])
  @@index([venueId])
  @@index([startTime])
  @@index([status])
  @@index([type])
}

model EventSeat {
  id           String          @id @default(uuid())

  eventId      String
  seatId       String
  ticketTypeId String?

  status       EventSeatStatus

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event       @relation(fields: [eventId], references: [id])
  seat         Seat        @relation(fields: [seatId], references: [id])
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])

  reservations Reservation[]
  bookingItems BookingItem[]

  @@unique([eventId, seatId])
  @@index([eventId])
  @@index([seatId])
  @@index([ticketTypeId])
  @@index([status])
}

model TicketType {
  id          String   @id @default(uuid())

  eventId     String
  name        String
  description String?
  price       Int
  quantity    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event       @relation(fields: [eventId], references: [id])
  eventSeats  EventSeat[]
  reservations Reservation[]
  bookingItems BookingItem[]

  @@unique([eventId, name])
  @@index([eventId])
}

enum EventSeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
}

enum EventCategory {
  CONCERT
  SPORTS
  CONFERENCE
  COMEDY
  THEATRE
  WORKSHOP
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Reservation{
  id            String   @id @default(uuid())
  userId        String
  eventId       String
  eventSeatId   String?
  ticketTypeId  String?

  quantity      Int
  status        ReservationStatus
  expiresAt     DateTime

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payment       Payment?

  user           User        @relation(fields: [userId], references: [id]) 
  event          Event       @relation(fields: [eventId], references: [id]) 
  eventSeat      EventSeat?   @relation(fields: [eventSeatId], references: [id]) 
  ticketType     TicketType? @relation(fields: [ticketTypeId], references: [id]) 

  @@index([userId])
  @@index([eventId])
  @@index([eventSeatId])
  @@index([ticketTypeId])
  @@index([status])
  @@index([expiresAt])
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CONFIRMED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking{
  id                String              @id @default(uuid())
  userId            String
  eventId           String

  totalAmount       Decimal
  status            BookingStatus

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  bookingItems      BookingItem[]
  payment           Payment?
  tickets           Ticket[]

  user              User                @relation(fields: [userId], references: [id])
  event             Event               @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

model BookingItem{
  id                String              @id @default(uuid())

  bookingId         String
  eventSeatId       String?
  ticketTypeId      String?

  quantity          Int
  unitPrice         Decimal
  totalPrice        Decimal

  tickets           Ticket[]

  createdAt         DateTime            @default(now())
  
  booking           Booking             @relation(fields: [bookingId], references: [id])
  eventSeat         EventSeat?          @relation(fields: [eventSeatId], references: [id])
  ticketType        TicketType?          @relation(fields: [ticketTypeId], references: [id])

  @@index([bookingId])
  @@index([eventSeatId])
  @@index([ticketTypeId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
}

model Payment {
  id               String        @id @default(uuid())

  reservationId    String        @unique
  bookingId        String?       @unique
  userId           String

  amount           Decimal
  status           PaymentStatus @default(PENDING)
  method           PaymentMethod?

  transactionId    String?       @unique
  gatewayPaymentId String?       @unique
  gatewayOrderId   String?       @unique

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  reservation      Reservation  @relation(fields: [reservationId], references: [id])
  booking          Booking?     @relation(fields: [bookingId], references: [id])
  user             User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

model Ticket {
  id            String       @id @default(uuid())
  bookingId     String
  bookingItemId String

  ticketCode    String       @unique
  status        TicketStatus @default(ACTIVE)

  issuedAt      DateTime     @default(now())
  usedAt        DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  booking       Booking      @relation(fields: [bookingId], references: [id])
  bookingItem   BookingItem  @relation(fields: [bookingItemId], references: [id])

  @@index([bookingId])
  @@index([bookingItemId])
  @@index([status])
}
