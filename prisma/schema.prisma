generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  ORGANIZER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    Event[]
  reservations Reservation[]

}

model Venue {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  address     String
  city        String
  state       String
  country     String
  postalCode  String
  capacity    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events      Event[]
  seats       Seat[]
}

enum SeatType {
  REGULAR
  PREMIUM
  VIP
}

model Seat {
  id        String   @id @default(uuid())

  venueId   String
  row       String
  number    Int
  section   String?
  type      SeatType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue      Venue       @relation(fields: [venueId], references: [id])
  eventSeats EventSeat[]

  @@unique([venueId, row, number])
  @@index([venueId])
}

enum EventType {
  SEATED
  GENERAL_ADMISSION
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String?

  category    EventCategory
  type        EventType    @default(SEATED)
  status      EventStatus

  startTime   String
  endTime     String

  venueId     String
  organizerId String

  imageUrl    String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  venue       Venue         @relation(fields: [venueId], references: [id])
  organizer   User          @relation(fields: [organizerId], references: [id])

  eventSeats  EventSeat[]
  ticketTypes TicketType[]
  reservations Reservation[]

  @@index([organizerId])
  @@index([venueId])
  @@index([startTime])
  @@index([status])
  @@index([type])
}

model EventSeat {
  id           String          @id @default(uuid())

  eventId      String
  seatId       String
  ticketTypeId String?

  status       EventSeatStatus

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event       @relation(fields: [eventId], references: [id])
  seat         Seat        @relation(fields: [seatId], references: [id])
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])

  reservations Reservation[]

  @@unique([eventId, seatId])
  @@index([eventId])
  @@index([seatId])
  @@index([ticketTypeId])
  @@index([status])
}

model TicketType {
  id          String   @id @default(uuid())

  eventId     String
  name        String
  description String?
  price       Int
  quantity    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event       @relation(fields: [eventId], references: [id])
  eventSeats  EventSeat[]
  reservations Reservation[]

  @@unique([eventId, name])
  @@index([eventId])
}

enum EventSeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
}

enum EventCategory {
  CONCERT
  SPORTS
  CONFERENCE
  COMEDY
  THEATRE
  WORKSHOP
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Reservation{
  id            String   @id @default(uuid())
  userId        String
  eventId       String
  eventSeatId   String?
  ticketTypeId  String?

  quantity      Int
  status        ReservationStatus
  expiresAt     DateTime

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user           User        @relation(fields: [userId], references: [id]) 
  event          Event       @relation(fields: [eventId], references: [id]) 
  eventSeat      EventSeat?   @relation(fields: [eventSeatId], references: [id]) 
  ticketType     TicketType? @relation(fields: [ticketTypeId], references: [id]) 

  @@index([userId])
  @@index([eventId])
  @@index([eventSeatId])
  @@index([ticketTypeId])
  @@index([status])
  @@index([expiresAt])
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CONFIRMED
  CANCELLED
}